---
import { site } from '@/data/site';

const links = [
  { href: '#sobre', label: 'Sobre mí' },
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#contacto', label: 'Contacto' },
];
---

<div class="progress" data-scroll-progress aria-hidden="true"></div>

<header class="header">
  <a href="#inicio" aria-label="Volver al inicio">{site.shortName}</a>
  <nav aria-label="Principal">
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-progress);
    height: 4px;
    background: var(--nav-color);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: background var(--dur-base);
  }

  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: calc(14px + env(safe-area-inset-top, 0px)) var(--gutter) 14px;
    color: var(--nav-color);
    font-size: var(--text-label);
    font-weight: 800;
    font-stretch: 112%;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color var(--dur-base);
  }

  ul {
    display: flex;
    gap: clamp(12px, 3vw, 36px);
  }

  a {
    display: inline-block;
    padding: 10px 0;
    background: linear-gradient(currentColor, currentColor) 0 85% / 0 var(--border) no-repeat;
    text-decoration: none;
    transition: background-size var(--dur-fast) var(--ease-out);
  }

  @media (max-width: 760px) {
    .header {
      font-size: 0.7rem;
      letter-spacing: 0.03em;
      white-space: nowrap;
    }
  }

  a:hover,
  a:focus-visible {
    background-size: 100% var(--border);
  }
</style>
