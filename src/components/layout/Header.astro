---
import { site } from '@/data/site';
import { getLang, homePath, languages, langs } from '@/i18n';
import { useTranslations } from '@/i18n/ui';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const other = langs.find((code) => code !== lang) ?? lang;

const links = [
  { href: '#sobre', label: t.nav.about },
  { href: '#proyectos', label: t.nav.projects },
  { href: '#contacto', label: t.nav.contact },
];
---

<div class="progress" data-scroll-progress aria-hidden="true"></div>

<header class="header">
  <a href="#inicio" aria-label={t.nav.home}>{site.shortName}</a>
  <nav aria-label={t.nav.label}>
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
      <li>
        <a
          class="lang"
          href={homePath(other)}
          hreflang={languages[other].hreflang}
          lang={other}
          aria-label={t.switchTo}
          title={languages[other].label}>{languages[other].short}</a
        >
      </li>
    </ul>
  </nav>
</header>
<style>
  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-progress);
    height: 4px;
    background: var(--nav-color);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: background var(--dur-base);
  }

  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: calc(14px + env(safe-area-inset-top, 0px)) var(--gutter) 14px;
    color: var(--nav-color);
    font-size: var(--text-label);
    font-weight: 800;
    font-stretch: 112%;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color var(--dur-base);
  }

  ul {
    display: flex;
    align-items: center;
    gap: clamp(12px, 3vw, 36px);
  }

  a {
    display: inline-block;
    padding: 10px 0;
    background: linear-gradient(currentColor, currentColor) 0 85% / 0 var(--border) no-repeat;
    text-decoration: none;
    transition: background-size var(--dur-fast) var(--ease-out);
  }

  @media (max-width: 760px) {
    .header {
      font-size: 0.7rem;
      letter-spacing: 0.03em;
      white-space: nowrap;
    }

    ul {
      gap: 9px;
    }

    .lang {
      padding: 4px 6px;
    }
  }

  /* Small phones: the full set of links plus the language switch no longer fits. */
  @media (max-width: 400px) {
    .header {
      font-size: 0.64rem;
      letter-spacing: 0;
    }
  }

  /* The name already fills the hero; the menu needs the room. */
  @media (max-width: 350px) {
    .header > a {
      display: none;
    }

    .header {
      justify-content: flex-end;
    }
  }

  .lang {
    padding: 6px 10px;
    border: var(--border) solid currentColor;
    border-radius: var(--radius-pill);
    background: none;
    line-height: 1;
  }

  .lang:hover,
  .lang:focus-visible {
    background: var(--nav-color);
    color: var(--color-ink);
  }

  a:not(.lang):hover,
  a:not(.lang):focus-visible {
    background-size: 100% var(--border);
  }
</style>
