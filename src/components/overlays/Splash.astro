---
import { chapters } from '@/data/chapters';
import { site } from '@/data/site';

/** The chapter colors burst in order behind the name, then back to the first one. */
const bursts = [...chapters.slice(1), chapters[0]].map((chapter) => chapter.bg);
const letters = [...site.shortName];
const start = chapters[0].persona;
---

<div
  class="splash"
  data-splash
  aria-hidden="true"
  style={`--ox:${start.x}vw;--oy:${start.y}vh;--ox-phone:${start.phone.x}vw;--oy-phone:${start.phone.y}vh`}
>
  {bursts.map((color, index) => <i style={`--bg:var(--color-${color});--n:${index}`} />)}
  <div class="name">
    <b>{letters.map((letter, index) => <span style={`--n:${index}`}>{letter}</span>)}</b>
    <small>Portfolio</small>
  </div>
</div>

<style>
  /* The name rises, the chapter colors burst behind it, then the screen closes into the persona. */
  .splash {
    position: fixed;
    inset: 0;
    z-index: var(--z-splash);
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--color-ink);
    color: var(--color-paper);
    cursor: pointer;
    animation: splash-close 0.9s var(--ease-out) 3.9s forwards;
  }

  :global(.no-splash) .splash {
    display: none;
  }

  i {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 300vmax;
    height: 300vmax;
    margin: -150vmax 0 0 -150vmax;
    border-radius: 50%;
    background: var(--bg);
    transform: scale(0);
    /* Each color eases in slowly and overlaps the next, so the sequence reads as one wave. */
    animation: splash-burst 1.1s cubic-bezier(0.4, 0, 0.2, 1) calc(0.9s + var(--n) * 0.45s) forwards;
  }

  .name {
    position: relative;
    text-align: center;
  }

  b {
    display: block;
    overflow: hidden;
    padding-top: 0.12em;
    font-family: var(--font-display);
    font-size: clamp(3rem, 17vw, 15rem);
    font-weight: 900;
    font-stretch: 125%;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  b span {
    display: inline-block;
    transform: translateY(110%);
    animation: splash-letter 0.7s var(--ease-out) calc(0.1s + var(--n) * 0.07s) forwards;
  }

  small {
    display: block;
    margin-top: 1.5vh;
    font-size: clamp(0.7rem, 1.2vw, 1rem);
    font-weight: 800;
    font-stretch: 112%;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0;
    animation: splash-fade 0.5s ease 0.7s forwards;
  }

  @keyframes splash-letter {
    to {
      transform: none;
    }
  }

  @keyframes splash-fade {
    to {
      opacity: 1;
    }
  }

  @keyframes splash-burst {
    to {
      transform: scale(1);
    }
  }

  @keyframes splash-close {
    from {
      clip-path: circle(150vmax at var(--ox) var(--oy));
    }
    to {
      clip-path: circle(0 at var(--ox) var(--oy));
      visibility: hidden;
    }
  }

  @media (max-width: 760px) {
    .splash {
      --ox: var(--ox-phone);
      --oy: var(--oy-phone);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .splash {
      display: none;
    }
  }
</style>

<script>
  const splash = document.querySelector<HTMLElement>('[data-splash]');

  if (splash) {
    const dismiss = () => {
      splash.remove();
      try {
        sessionStorage.setItem('splash-seen', '1');
      } catch {
        // Storage blocked: the splash plays again next load.
      }
    };

    splash.addEventListener('animationend', (event) => {
      if (event.animationName.startsWith('splash-close')) dismiss();
    });
    splash.addEventListener('click', dismiss);
  }
</script>
