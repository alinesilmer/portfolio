---
import { Image } from 'astro:assets';

import type { Project } from '@/data/projects';
import { externalLink } from '@/lib/links';

interface Props {
  project: Project;
  index: number;
  open?: boolean;
}

/** Tab positions repeat so they stay inside the shelf however many projects there are. */
const TAB_SLOTS = 5;

const { project, index, open = false } = Astro.props;
const previewId = `proyecto-${index + 1}`;
const facts = [
  ['Rol', project.role],
  ['Stack', project.stack],
  ['Año', project.year],
].filter((fact): fact is [string, string] => Boolean(fact[1]));
---

<article class:list={['file', { 'is-open': open }]} data-file style={`--slot:${index % TAB_SLOTS}`}>
  <button class="tab" type="button" aria-expanded={open ? 'true' : 'false'} aria-controls={previewId}>
    {project.name.toLowerCase()}
  </button>

  <div class="preview" id={previewId}>
    <Image
      src={project.image}
      alt={`Vista previa de ${project.name}`}
      widths={[440, 880]}
      sizes="(max-width: 760px) 100vw, 45vw"
      loading="lazy"
    />
    <a class="portal" href={project.url} aria-label={`Abrir ${project.name} en una pestaña nueva`} {...externalLink}></a>

    <div class="detail">
      <h3>{project.name}</h3>
      <p>{project.description}</p>
      {
        facts.length > 0 && (
          <dl>
            {facts.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      <a href={project.url} {...externalLink}>Visitar sitio ↗</a>
    </div>
  </div>
</article>

<style>
  /* A tabbed file divider: closed it shows a slice of the project, open it widens in place. */
  .file {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    cursor: pointer;
    box-shadow: -12px 0 20px -14px color-mix(in srgb, var(--color-ink) 70%, transparent);
    transition: flex-grow 0.55s var(--ease-out);
  }

  .file:first-child {
    border-radius: var(--radius-m) 0 0 var(--radius-m);
  }

  .file:last-child {
    border-radius: 0 var(--radius-m) var(--radius-m) 0;
  }

  .file:hover {
    flex-grow: 1.5;
  }

  .file.is-open {
    flex-grow: 8;
    cursor: default;
  }

  .tab {
    position: absolute;
    top: calc(4% + var(--slot) * 11%);
    left: -27px;
    width: 28px;
    padding: 16px 0;
    border: 0;
    border-radius: 0 12px 12px 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    white-space: nowrap;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    cursor: pointer;
  }

  .preview {
    position: absolute;
    inset: 10px 0 10px 10px;
    overflow: hidden;
    border-radius: var(--radius-s) 0 0 var(--radius-s);
    background: var(--color-ink);
  }

  .file:last-child .preview {
    right: 10px;
    border-radius: var(--radius-s);
  }

  .preview :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  .file.is-open .preview :global(img) {
    object-position: 0 0;
  }

  /* The open divider is a portal: the whole preview links to the live site. */
  .portal {
    position: absolute;
    inset: 0;
    display: none;
  }

  .file.is-open .portal {
    display: block;
  }

  .portal:focus-visible {
    outline: 3px solid var(--color-yellow);
    outline-offset: -6px;
  }

  .detail {
    position: absolute;
    bottom: 14px;
    left: 14px;
    display: grid;
    gap: 10px;
    width: clamp(250px, 32vw, 440px);
    max-width: calc(100% - 28px);
    padding: 16px 18px 18px;
    border-radius: 14px;
    background: var(--color-paper);
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity 0.3s,
      transform var(--dur-base) var(--ease-out),
      visibility 0s 0.3s;
  }

  .file.is-open .detail {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0.25s, 0.25s, 0s;
  }

  h3 {
    font-family: var(--font-tall);
    font-size: clamp(1.8rem, 3.2vw, 2.8rem);
    font-weight: 900;
    line-height: 0.9;
    text-transform: uppercase;
  }

  dl {
    display: grid;
    grid-template-columns: 1fr 1.4fr auto;
    gap: 10px 16px;
    padding-top: 10px;
    border-top: var(--border) solid currentColor;
  }

  dt {
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  dd {
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .detail a {
    justify-self: start;
    padding: 4px 0;
    border-bottom: var(--border) solid currentColor;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    /* Stacked strips that open downward. */
    .file {
      flex: none;
      height: 74px;
      margin-top: -6px;
      box-shadow: 0 -10px 18px -14px color-mix(in srgb, var(--color-ink) 70%, transparent);
      transition: height 0.5s var(--ease-out);
    }

    .file:first-child,
    .file:last-child {
      border-radius: 14px;
    }

    .file.is-open {
      height: 400px;
    }

    .tab {
      top: -22px;
      left: calc(4% + var(--slot) * 8%);
      width: auto;
      max-width: 60%;
      overflow: hidden;
      text-overflow: ellipsis;
      padding: 5px 12px 3px;
      border-radius: 10px 10px 0 0;
      writing-mode: horizontal-tb;
      transform: none;
    }

    .preview,
    .file:last-child .preview {
      inset: 10px;
      border-radius: var(--radius-s);
    }
  }
</style>
