---
import Chapter from '@/components/layout/Chapter.astro';
import { education } from '@/data/site';
import { getLang } from '@/i18n';
import { useTranslations } from '@/i18n/ui';

const lang = getLang(Astro.url);
const { about } = useTranslations(lang);
---

<Chapter id="sobre">
  <div class="column">
    <p class="kicker">{about.kicker}</p>
    <h2 class="tall statement">{about.statement}</h2>
    <p class="lede">{about.lede}</p>
    <ol class="ruled timeline" aria-label={about.timeline}>
      {
        education.map((entry) => (
          <li>
            <span>{entry.when[lang]}</span>
            <span>{entry.what[lang]}</span>
            <span>{entry.where}</span>
          </li>
        ))
      }
    </ol>
  </div>
</Chapter>

<style>
  .statement {
    font-size: clamp(2.3rem, 5.8vw, 6.2rem);
  }

  .timeline li {
    grid-template-columns: 12ch 1fr 1fr;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 760px) {
    .timeline li {
      grid-template-columns: 10ch 1fr;
    }

    .timeline li span:last-child {
      grid-column: 2;
    }
  }
</style>
