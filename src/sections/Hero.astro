---
import Chapter from '@/components/layout/Chapter.astro';
import { site } from '@/data/site';
import { getLang } from '@/i18n';
import { useTranslations } from '@/i18n/ui';

const { hero } = useTranslations(getLang(Astro.url));
---

<Chapter id="inicio">
  <h1 class="headline">
    <span class="tagline">{site.name} · {hero.tagline}</span>
    {hero.lines.map((line, index) => <span style={`--n:${index}`}>{line}</span>)}
  </h1>
  <p class="hint">{hero.hint}</p>
</Chapter>

<style>
  .headline {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 900;
    font-stretch: 125%;
    line-height: 0.86;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .headline span {
    display: block;
    animation: hero-rise 0.9s var(--ease-out) calc(var(--n) * 0.08s) both;
  }

  /* Says who and what inside the heading itself, for readers and search engines alike. */
  .headline .tagline {
    margin-bottom: 2.4vh;
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 800;
    font-stretch: 112%;
    line-height: 1.2;
    letter-spacing: 0.1em;
    animation: hero-fade 0.6s ease 0.4s both;
  }

  .hint {
    position: absolute;
    top: 80vh;
    left: 50%;
    font-size: clamp(0.95rem, 1.3vw, 1.2rem);
    font-weight: 800;
    font-stretch: 112%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  @media (max-width: 760px) {
    .hint {
      top: 86vh;
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes hero-rise {
    from {
      clip-path: inset(0 0 100% 0);
      transform: translateY(0.35em);
    }
    to {
      clip-path: inset(-10% 0 -10% 0);
      transform: none;
    }
  }
</style>
